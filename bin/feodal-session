#!/bin/sh
set -eu
export XDG_CURRENT_DESKTOP=Feodal
export XDG_SESSION_DESKTOP=feodal
export XDG_SESSION_TYPE=x11
# Built into GTK 3: dark apps without installing another theme.
export GTK_THEME="${GTK_THEME:-Adwaita:dark}"
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    exec dbus-run-session -- "$0" "$@"
fi

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd DISPLAY XAUTHORITY \
        XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE ||
        printf '%s\n' 'feodal-session: warning: could not update D-Bus activation environment' >&2
fi

helper_pids=
start_optional() {
    helper=$1
    shift
    if command -v "$helper" >/dev/null 2>&1; then
        "$helper" "$@" &
        helper_pids="$helper_pids $!"
    else
        printf 'feodal-session: warning: optional helper not found: %s\n' "$helper" >&2
    fi
}

run_optional() {
    helper=$1
    shift
    if command -v "$helper" >/dev/null 2>&1; then
        "$helper" "$@" ||
            printf 'feodal-session: warning: optional helper failed: %s\n' "$helper" >&2
    else
        printf 'feodal-session: warning: optional helper not found: %s\n' "$helper" >&2
    fi
}

cleanup() {
    for pid in $helper_pids; do
        kill "$pid" 2>/dev/null || true
    done
    for pid in $helper_pids; do
        wait "$pid" 2>/dev/null || true
    done
}
trap cleanup EXIT

start_optional feodal-panel
start_optional nm-applet
start_optional pasystray
start_optional xfce4-power-manager --no-daemon
start_optional dunst -config /etc/xdg/feodal/dunstrc
start_optional stalonetray -c /etc/xdg/feodal/stalonetrayrc
run_optional xrdb -merge /etc/xdg/feodal/Xresources
run_optional feodal-input --apply
start_optional "${FEODAL_POLKIT_AGENT:-/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1}"

wm_status=0
openbox --config-file /etc/xdg/feodal/openbox.xml || wm_status=$?
exit "$wm_status"
