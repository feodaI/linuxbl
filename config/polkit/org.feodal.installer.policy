<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Feodal Linux</vendor>
  <action id="org.feodal.installer">
    <description>Install Feodal Linux to a disk</description>
    <description xml:lang="uk">Встановити Feodal Linux на диск</description>
    <message>Authentication is required to erase a disk and install Feodal</message>
    <message xml:lang="uk">Щоб стерти диск і встановити Feodal, потрібна автентифікація</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/feodal/feodal-install-backend</annotate>
  </action>
</policyconfig>
